{
  "version": 2,
  "builds": [
    {
      "src": "cloud_gaming_optimizer/web_app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "cloud_gaming_optimizer/web_app.py"
    }
  ],
  "env": {
    "PYTHONPATH": ".",
    "FLASK_ENV": "production"
  }
}
